@article{kovacevic2024,
  title = {An Information-Theoretic Analog of the Twin Paradox},
  author = {Kovačević, Mladen and Pinelis, Iosif and Kountouris, Marios},
  date = {2024-05-01},
  journaltitle = {Europhysics Letters},
  volume = {146},
  number = {4},
  pages = {42002},
  publisher = {IOP Publishing},
  issn = {0295-5075},
  doi = {10.1209/0295-5075/ad3eae},
  url = {https://doi.org/10.1209/0295-5075/ad3eae},
  abstract = {Abstract We revisit the familiar scenario involving two parties in relative motion, in which Alice stays at rest while Bob goes on a journey at speed βc along an arbitrary trajectory and reunites with Alice after a certain period of time. It is a well-known consequence of special relativity that the time that passes until they meet again is different for the two parties and is shorter in Bob's frame by a factor of . We investigate how this asymmetry manifests itself from an information-theoretic viewpoint. Assuming that Alice and Bob transmit signals of equal average power to each other during the whole journey, and that additive white Gaussian noise is present at both sides, we show that the maximum number of bits per second that Alice can transmit reliably to Bob is always higher than the one Bob can transmit to Alice. Equivalently, the energy per bit invested by Alice is lower than that invested by Bob, meaning that the traveler is less efficient from the communication perspective, as conjectured by Jarett and Cover.},
  langid = {english},
  keywords = {PRISMA:forward,relativistic-timekeeping,tier3}
}

@article{lamport1978,
  title = {Time, Clocks, and the Ordering of Events in a Distributed System},
  author = {Lamport, Leslie},
  date = {1978-07},
  journaltitle = {Communications of the ACM},
  volume = {21},
  number = {7},
